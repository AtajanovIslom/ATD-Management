POSTGRES_DB=hisobot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
JWT_SECRET_KEY=change-me-to-a-long-random-string
HTTP_PORT=80
HTTPS_PORT=443

# --- Firebase / mobil bildirishnomalar ---
# Service account JSON faylini backend/secrets/firebase-service-account.json
# ga qo'ying (docker-compose o'sha papkani konteynerga ulaydi).
# Push'ni butunlay o'chirish uchun: PUSH_ENABLED=0
PUSH_ENABLED=1
# Flutter ilovadagi notification channel ID bilan bir xil bo'lishi shart
FCM_ANDROID_CHANNEL_ID=atd_high_importance

# --- ISUP (kadrlar tizimi) — tabel raqami bo'yicha xodim ma'lumoti ---
# Interaktiv arizada xodim ismi/lavozimi shu yerdan olinadi.
ISUP_USER=api
ISUP_PASSWORD=change-me

# --- Telegram bot ---
# @BotFather → /newbot → tokenni shu yerga. Bo'sh qolsa Telegram o'chiq.
TELEGRAM_BOT_TOKEN=
# Telegram webhook'ni shu manzilga yuboradi (internetdan ochiq HTTPS)
PUBLIC_BASE_URL=https://atd.uzbeksteel.uz
